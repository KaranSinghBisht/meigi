# Meigi's shared settings. Copy this file to `.env` at the repo root (mode 600). services/agent, services/signer,
# services/verifier and services/x402-demo read it (`tsx --env-file=../../.env`), and so do the scripts in contracts/.
# Names and placeholders only: every secret is left empty. The addresses, T-numbers and ids are the public Sepolia
# deployment. An empty optional value counts as unset. The signer's key lives apart, in `.env.signer` (end of file).

## Chain (Sepolia)
# The primary JSON-RPC, for every service and script.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional second RPC (https, or http on loopback): reads move there within 4 s of a hung primary.
SEPOLIA_RPC_FALLBACK_URL=https://sepolia.gateway.tenderly.co
# The block the v2 registry was deployed at: scripts/deploy-demo.sh reads history from here.
REGISTRY_FROM_BLOCK=11781105

## Contracts (contracts/deployments/11155111.json)
# PayeeRegistry: a T-number's registered payout.
REGISTRY_ADDRESS=0x205c977cF1f4Ed42e51a48759550eF40160A6396
# PayeeResolver: the ENS wildcard resolver for t<T-number>.payee.eth.
RESOLVER_ADDRESS=0x096ebC07eE87fbb19FF920a5c81b2Ad5c9104A1e
# PayRouter.
ROUTER_ADDRESS=0xbA95BA5D4a2244cce46a76920f411B225116850C
# The yen token the vault pays in (mJPYC).
TOKEN_ADDRESS=0xEcA2B093682a46B14b143474d188A120bA2d0EC2
# AgentVault: the funds the AP agent pays from.
VAULT_ADDRESS=0x87A798CD92dE1340B1b761dd45196AC82bEF793B

## Keys for the contract scripts (forge, contracts/script); the running services never need them
# Deploys the contracts and the ENS pieces, and its address.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# The AgentVault's owner (approves vendors, sets the vault's agent), and its address.
VAULT_OWNER_PRIVATE_KEY=
VAULT_OWNER_ADDRESS=
# The demo vendor 株式会社メイギ商事 (T2011001234567): its controller key and address, for seeding and its ENS claim.
DEMO_VENDOR_CONTROLLER_PRIVATE_KEY=
DEMO_VENDOR_CONTROLLER=
# Its payout wallet's key, and the registered payout.
DEMO_VENDOR_PAYOUT_PRIVATE_KEY=
DEMO_VENDOR_PAYOUT=0x9B4fc8994FcF2d5FE08a82A9454B61AA14D647e4
# The key of the address the bank-change email asks to pay (the scammer), for building demo documents.
DEMO_SCAMMER_PRIVATE_KEY=
# That address: the x402 demo's compromised mirror pays it too.
DEMO_SCAMMER=0xdCa52b5FA181a3307eCa852935BD40e3E0096d5b

## Verifier (services/verifier)
# The attester that submits verified registrations to the PayeeRegistry, and its address.
ATTESTER_PRIVATE_KEY=
ATTESTER_ADDRESS=
# World ID (IDKit) for company officers: the app id and the relying-party id.
WORLD_APP_ID=app_30048059325fb60b495b43dd2fe67ae0
WORLD_RP_ID=rp_d14a7db12e6bfc65
# The relying party's signing key (from World's developer portal), and its address.
WORLD_RP_SIGNING_KEY=
WORLD_RP_SIGNER_ADDRESS=
# 1: accept the fictional fixture companies (office 9999) without the NTA, domain and World ID checks. 0 in production.
VERIFIER_FIXTURES=1

## AP agent (services/agent) and its signer (services/signer)
# The vault's agent: only the signer holds its key (.env.signer), and the agent refuses to start if it sees one.
AGENT_ADDRESS=0xa73b6418AadCd5C548eEfF828C31081cAe7FBA68
# The shared secret the signer checks on every call. The same value goes in .env.signer (openssl rand -hex 32).
SIGNER_TOKEN=
# 1: pay through the ENS MandateGate (live since 2026-09-26). 0, the default, pays the vault directly (the rollback).
SIGNER_VIA_GATE=1
# The MandateGate: the vault's agent while SIGNER_VIA_GATE=1.
MANDATE_GATE_ADDRESS=0x591dd2b2716b46740C665749A60209B7b22e83BF
# The buyer company whose mandate the gate enforces: ap.t4999900000005.payee.eth (fictional 株式会社ハルカ製作所).
MANDATE_PRINCIPAL=4999900000005
# Browser origins allowed to call the agent, the verifier and the x402 demo.
APP_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:5190
# The agent's LLM: local (Ollama, the booth's), none, proxy, anthropic or workers-ai.
LLM_PROVIDER=local
# The Ollama model for LLM_PROVIDER=local.
LOCAL_LLM_MODEL=gemma4:e4b
# World ID for Agents (a verified human releases a hold): the sandbox issuer, and the client World issued.
WORLD_AGENTS_ISSUER=https://sandbox.auth.world.org
# Its client id and secret. Without them, approvals are off; start with SIGNER_VERIFY_APPROVAL=0 scripts/ap-stack.sh.
WORLD_AGENTS_CLIENT_ID=
WORLD_AGENTS_CLIENT_SECRET=
# How the client authenticates at the token endpoint: client_secret_basic (the default) or client_secret_post.
WORLD_AGENTS_AUTH_METHOD=client_secret_basic
# Curvegrid MultiBaas on Sepolia (settlement history): https://<deployment>.multibaas.com and an API key.
MULTIBAAS_URL=
MULTIBAAS_API_KEY=
# MultiBaas on Mizuhiki Awaji (chain 6497), the same pair.
MULTIBAAS_AWAJI_URL=
MULTIBAAS_AWAJI_API_KEY=
# Intercepta address screening (agent and x402 demo). Optional: screening is off without it.
INTERCEPTA_API_KEY=
# The team's AI proxy Worker (workers/ai-proxy). Optional: triage and the LLM run on this machine without it.
AI_PROXY_URL=https://meigi-ai-proxy.karanbishttt.workers.dev
# Its bearer token.
AI_PROXY_TOKEN=

## x402 demo (services/x402-demo)
# A registered merchant (fictional, office 9999): its T-number, its payout's key and the registered payout.
DEMO_MERCHANT_T_NUMBER=T8999900000001
DEMO_MERCHANT_PAYOUT_PRIVATE_KEY=
DEMO_MERCHANT_PAYOUT=0x0C1d13e3CC82f3a6e0694D3EDe031595Ce32578D
# The second registered merchant (株式会社ミナトGPUクラウド, fictional): its T-number and registered payout.
DEMO_MINATO_T_NUMBER=T6999900000003
DEMO_MINATO_PAYOUT=0x4d6D5528f4a4c9E404130Fab23F5FA5DDcaffD30
# The guarded buyer agent that pays x402 requests: its key and address.
DEMO_BUYER_PRIVATE_KEY=
DEMO_BUYER=
# The facilitator that settles x402 payments on-chain: its key and address.
FACILITATOR_PRIVATE_KEY=
FACILITATOR=

## .env.signer: a separate file at the repo root, mode 600, loaded only by the signer. Its names, never set here:
# AGENT_PRIVATE_KEY=   the vault agent's key (0x followed by 64 hex characters)
# SIGNER_TOKEN=        the same value as SIGNER_TOKEN above
# SIGNER_APPROVERS=    Phase 2: the only World ID approvers (pairwise subjects, comma-separated) the signer accepts

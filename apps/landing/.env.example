# Copy to .env (or .env.local) and fill in. Every value is optional and public:
# VITE_ variables are compiled into the browser bundle, so never put secrets here.

# Where the "enter" glide ends up. Relative paths work when the app shares a host.
VITE_APP_URL=/app

# Footer links. A pill is hidden while its URL is empty.
VITE_GITHUB_URL=
VITE_DOCS_URL=

# Live registry reads on Sepolia. With the RPC or the address missing, the
# status pill is hidden and the resolver says the registry isn't deployed yet.
# The current deployment is listed in contracts/deployments/11155111.json.
VITE_RPC_URL=https://your-sepolia-rpc.example
VITE_REGISTRY_ADDRESS=0x205c977cF1f4Ed42e51a48759550eF40160A6396

# Block the registry was deployed in; PayeeRegistered logs are scanned from
# here. Public RPCs cap eth_getLogs ranges, so don't leave this at 0.
VITE_REGISTRY_FROM_BLOCK=11781105

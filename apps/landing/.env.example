# Copy to .env.local and adjust. Every value is optional and public: VITE_
# variables are compiled into the browser bundle, so never put secrets here.

# Where the "enter" glide ends up. Relative paths work when the app shares a host.
VITE_APP_URL=/app

# Footer links. A pill is hidden when its URL is empty.
VITE_GITHUB_URL=
VITE_DOCS_URL=

# Live registry reads (Sepolia). If the RPC or the address is missing, the
# status pill is hidden and the resolver says the registry isn't deployed yet.
# Values below are the current deployment from contracts/deployments/11155111.json.
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_REGISTRY_ADDRESS=0x205c977cF1f4Ed42e51a48759550eF40160A6396

# Block the registry was deployed in. Keeps the PayeeRegistered log scan inside
# public RPC range limits; without it the scan starts at genesis.
VITE_REGISTRY_DEPLOY_BLOCK=11781105

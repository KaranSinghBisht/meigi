# Copy to .env.local and adjust. Every VITE_ value is compiled into the browser
# bundle and is public, so never put secrets here. Leave a line unset to use
# its default.

# Services (each allows http://localhost:5173 and http://localhost:4173 by default).
VITE_VERIFIER_URL=http://localhost:8787
VITE_AGENT_URL=http://localhost:8788
VITE_MERCHANT_URL=http://localhost:8790

# Chain reads (Sepolia). The event feed scans logs from VITE_REGISTRY_FROM_BLOCK
# in chunks, because public RPCs cap eth_getLogs ranges.
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_REGISTRY_FROM_BLOCK=11781105

# Contract addresses default to contracts/deployments/11155111.json, so a
# redeploy needs no change here. Set these only to point at another deployment.
VITE_REGISTRY_ADDRESS=
VITE_VAULT_ADDRESS=
VITE_TOKEN_ADDRESS=

# World ID 4.0 (IDKit). The environment must match the verifier's
# WORLD_ENVIRONMENT: sandbox = World ID Sandbox app, production = World App.
# The staging simulator rejects World ID 4.0 sessions (use sandbox for the live
# officer demo, with a verifier started with VERIFIER_FIXTURES=1 so a fictional
# office-9999 company such as T7999900000002 can register). The RP id is public; it
# is only needed if the verifier's rp-context response doesn't include rp_id.
VITE_WORLD_APP_ID=app_30048059325fb60b495b43dd2fe67ae0
VITE_WORLD_ENVIRONMENT=staging
VITE_WORLD_RP_ID=

# Optional: where the footer's "About Meigi" link goes (the landing page); a
# same-origin path such as / works.
VITE_LANDING_URL=

# Hosted build (the public demo link, on its own host). VITE_HOSTED=1: steps
# that need the verifier, agent or x402 demo show a "demo machine" panel and
# recorded runs unless the service is reachable from the page. Point
# VITE_LANDING_URL at the landing page's host.
VITE_HOSTED=
VITE_DEMO_VIDEO_URL=

# Optional links in the landing hero's dock.
VITE_GITHUB_URL=
VITE_DOCS_URL=
# Where /business "Talk to us" writes to (defaults to a placeholder on a reserved domain).
VITE_CONTACT_EMAIL=

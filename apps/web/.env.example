# Copy to .env.local and adjust. Every VITE_ value is compiled into the browser
# bundle and is public, so never put secrets here. Leave a line unset to use
# its default.

# Services (each allows http://localhost:5173 and http://localhost:4173 by default).
VITE_VERIFIER_URL=http://localhost:8787
VITE_AGENT_URL=http://localhost:8788
VITE_MERCHANT_URL=http://localhost:8790

# Chain reads (Sepolia). The event feed scans logs from VITE_REGISTRY_FROM_BLOCK
# in chunks, because public RPCs cap eth_getLogs ranges.
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_REGISTRY_FROM_BLOCK=11781105

# Contract addresses default to contracts/deployments/11155111.json, so a
# redeploy needs no change here. Set these only to point at another deployment.
VITE_REGISTRY_ADDRESS=
VITE_VAULT_ADDRESS=
VITE_TOKEN_ADDRESS=

# World ID 4.0 (IDKit). The RP id is public; it is only needed if the
# verifier's rp-context response doesn't include rp_id itself.
VITE_WORLD_APP_ID=app_30048059325fb60b495b43dd2fe67ae0
VITE_WORLD_ENVIRONMENT=staging
VITE_WORLD_RP_ID=

# Optional: where the footer's "About Meigi" link goes (the landing page).
VITE_LANDING_URL=

// The landing URL (meigi.karanbishttt.workers.dev) serves the same app build: its "/" is the Sakasa Fuji hero,
// and enter glides into the app on one canvas. Deploy with scripts/deploy-demo.sh.
//
// The Worker (worker/index.ts) runs first only for /api/*: GET /api/settlements reads Curvegrid MultiBaas
// server-side. Its URL and key are Worker secrets, never vars:
//   grep '^MULTIBAAS_URL=' ../../.env | cut -d= -f2- | npx wrangler secret put MULTIBAAS_URL --config wrangler.landing.jsonc
//   grep '^MULTIBAAS_API_KEY=' ../../.env | cut -d= -f2- | npx wrangler secret put MULTIBAAS_API_KEY --config wrangler.landing.jsonc
{
  "name": "meigi",
  "compatibility_date": "2026-09-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Registered payees listed even before the vault or router pays them (the x402 sellers): Meigi Shoji, Minato
    // GPU Cloud, Fuji Data, Bayside Advisory. Anyone the vault or router pays is listed too.
    "SETTLEMENT_PAYEES": "T2011001234567,T6999900000003,T8999900000001,T3999905000001",
    // Sepolia mJPYC (contracts/deployments/11155111.json): the saved queries filter on it, and MultiBaas's
    // meigi_mjpy alias must point at it, or the API answers 503.
    "SETTLEMENT_TOKEN": "0xEcA2B093682a46B14b143474d188A120bA2d0EC2",
    // The x402 research agent's wallet (services/x402-demo): mJPYC is mintable, so only its transfers count.
    // Required, like SETTLEMENT_TOKEN.
    "X402_BUYER": "0x708106dcdee19be75ffcd5df20cbb1b6b3089882",
    // "Ask the ledger": off until its live smoke test passes (then "true"); questions per UTC day for everyone, and
    // for each asker (an IPv4 address or IPv6 /64); and a hard daily budget of Workers AI neurons. ai-proxy keeps
    // 6,000 of the account's 10,000 free neurons a day and leaves the rest to this, so the paid plan never bills.
    "ASK_ENABLED": "false",
    "ASK_DAILY_CAP": "30",
    "ASK_IP_DAILY_CAP": "5",
    "ASK_DAILY_NEURONS": "3000"
  },
  // "Ask the ledger" (POST /api/ask): Workers AI as a binding (no key), 3 questions a minute per asker, and the daily
  // caps counted by one SQLite-backed Durable Object.
  "ai": { "binding": "AI" },
  "ratelimits": [{ "name": "ASK_LIMITER", "namespace_id": "1701", "simple": { "limit": 3, "period": 60 } }],
  "durable_objects": { "bindings": [{ "name": "ASK_QUOTA", "class_name": "AskQuota" }] },
  "migrations": [{ "tag": "ask-quota-v1", "new_sqlite_classes": ["AskQuota"] }]
}

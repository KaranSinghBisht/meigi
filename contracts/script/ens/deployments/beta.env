# Official "Sepolia ENSv2 Beta", redeployed 2026-09-15 (docs.ens.domains/learn/deployments). Source verified on Blockscout.
# The canonical Sepolia UniversalResolver below is viem's default, so stock viem resolves names here unconfigured.
ENS_REGISTRAR=0xabe76f6c8dfced81aa5a2bb8034202a7136b94ca
ENS_ROOT_REGISTRY=0x9703dbd26dab89504490994138cf2c575251a9ce
# Canonical proxy -> 0x6d80f217... -> UniversalResolverV2 0x5d25c1d6acbb71b7a28aa7899618a3412a8303e3
ENS_UNIVERSAL_RESOLVER=0xeeeeeeee14d718c2b47d9923deab1335e144eeee
# MockERC20 "USDC", 6 decimals, open mint
ENS_PAYMENT_TOKEN=0x16f95d91dba7da3aca778ec053df0ff6c6a8aa8e
# Namespace contracts for the agent-* commands, from contracts-v2 deployments/sepolia at 71a3b733 (this redeploy;
# the main branch still lists the June set). Source verified on Blockscout.
ENS_VERIFIABLE_FACTORY=0x9e726eb570beb6bceb495ab8cda7df517d4e841c
ENS_USER_REGISTRY_IMPL=0xa80338aaa8d23831cea25e858d1774534abb0263
ENS_PERMISSIONED_RESOLVER_IMPL=0x14f09fd05d4585759e54844dc9b00147131cf243
# Reverse-name adapters (contracts-v2 deployments/sepolia at 71a3b733): they let a contract's Ownable owner set the
# contract's primary name. ReverseRegistrarAdapter covers addr.reverse (via v1), the default adapter covers default.reverse.
ENS_REVERSE_ADAPTER=0x39993148caa6a20ae1f08e1b2427966e97f85aab
ENS_DEFAULT_REVERSE_ADAPTER=0x4f32a1c62e202922d4d6307126f43218db9da6f5
# Meigi's claims registry under payee.eth (a VerifiableFactory UserRegistry, attached 2026-09-26) and the
# ClaimedPayeeResolver its claimed names use (claim-* commands). CheckName accepts only this subregistry on payee.eth.
CLAIMS_REGISTRY=0xcA0317C97C0f915faaD6D8F354110eA98bDeD0B6
CLAIMS_RESOLVER=0xe4679507c08c61BE0328EDC72c91D62Bd6f03ebd
# CompanyNamespace (2026-09-26): the gate through which a claimed company issues text-only names under its payee name
# (ns-* and mandate-* commands), and the resolver of every issued name. Meigi's deployer is its brake.
COMPANY_NAMESPACE=0x7ECaD5Fd6892270F09D91aB296786186C5bC660A
# ERC-8004 agent of ap.t2011001234567.payee.eth (ENSIP-25 link), registered and owned by the company key.
NS_AP_8004_ID=10526
# MandateGate (2026-09-26): the AgentVault's agent while wired; pays only while ap.t4999900000005.payee.eth answers.
MANDATE_GATE=0x591dd2b2716b46740C665749A60209B7b22e83BF

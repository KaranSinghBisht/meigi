# @meigi/agent reads the repo-root .env (pnpm start / dev pass --env-file=../../.env).
# `pnpm local:chain` writes services/agent/.env.local for a local anvil; `pnpm dev:local` layers it on top.

# Chain (required)
SEPOLIA_RPC_URL=https://sepolia.example/rpc
CHAIN_ID=11155111                     # 31337 for anvil
AGENT_ADDRESS=0x...                   # the vault's agent; its key lives in ../../.env.signer, for services/signer only
SIGNER_URL=http://127.0.0.1:8796      # services/signer
SIGNER_TOKEN=                         # same value as in .env.signer (openssl rand -hex 32); never AGENT_PRIVATE_KEY here
REGISTRY_ADDRESS=0x205c977cF1f4Ed42e51a48759550eF40160A6396
VAULT_ADDRESS=0x87A798CD92dE1340B1b761dd45196AC82bEF793B
TOKEN_ADDRESS=                        # optional: checked against vault.token()
VENDOR_T_NUMBERS=2011001234567        # vendors listed by GET /vault (default: the demo vendor)
AGENT_PORT=8788
AGENT_HOST=127.0.0.1                  # 0.0.0.0 serves the LAN: then also set AGENT_API_TOKEN
AGENT_API_TOKEN=                      # optional, 16+ chars: every POST then needs Authorization: Bearer <token>
AGENT_ALLOWED_HOSTS=                  # extra Host names to answer on (LAN), e.g. 192.168.1.20:8788; localhost forms always work
APP_ORIGINS=http://localhost:5173,http://localhost:4173

# System-1 triage: backends tried in order until one answers; none → "triage unavailable" and every invoice holds
TRIAGE_BACKENDS=systemone             # local only: fine-tuned payee-0.8b (kev.serve). Opt in to Jev as a fallback with systemone,proxy (through the team proxy, inside its daily budget)
TRIAGE_REQUIRED=true                  # false: triage unavailable becomes a warning instead of a hold
TRIAGE_MIN_P_SAFE=0.9                 # PayeeBench @1% budget for payee-0.8b: deployed 0.884, oracle 0.905
SYSTEMONE_URL=http://127.0.0.1:8102/v1/systemone   # payee-0.8b via kev.serve, or any /v1/systemone server
SYSTEMONE_API_KEY=
SYSTEMONE_MODEL=kev-latest
AI_PROXY_URL=https://meigi-ai-proxy.karanbishttt.workers.dev   # workers/ai-proxy: /v1/systemone (Jev), /v1/chat (Llama); capped daily
AI_PROXY_TOKEN=

# System-2 LLM: the (deliberately gullible) agent proposal and hold explanations. It never decides a payment.
LLM_PROVIDER=local                    # local (Ollama; the demo default) | proxy (Llama 3.3 via AI_PROXY_URL, capped daily) | anthropic | none
LOCAL_LLM_URL=http://127.0.0.1:11434/v1   # any OpenAI-compatible server; https, or http on loopback only
LOCAL_LLM_MODEL=gemma4:e4b            # ollama pull gemma4:e4b (what the booth runs)
LOCAL_LLM_TIMEOUT_MS=60000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast   # the model LLM_PROVIDER=proxy asks for

# Intercepta (Web3 Antivirus) screening: optional, 1,000-call key, cached by address
INTERCEPTA_API_KEY=
INTERCEPTA_CACHE_PATH=../../data/agent/intercepta-cache.json
INTERCEPTA_MAX_CALLS=900
INTERCEPTA_TOXIC_THRESHOLD=50         # plus any severe trait (known_scammer, sanction_address, mixer_transfers, ...)

# Curvegrid MultiBaas: settlement history from its event index. Off unless both are set; RPC logs otherwise.
MULTIBAAS_URL=                        # a deployment on the agent's chain: https://<deployment>.multibaas.com
MULTIBAAS_API_KEY=                    # secret: server-side only
MULTIBAAS_AWAJI_URL=                  # a deployment on Mizuhiki Awaji (6497): GET /payments' `mizuhiki` section
MULTIBAAS_AWAJI_API_KEY=              # secret: server-side only
HISTORY_FROM_BLOCK=                   # RPC log scans start here; default 11781105 on Sepolia, 0 elsewhere
AUDIT_LOG_PATH=                       # hash-chained audit log; default ../../data/agent/audit-<CHAIN_ID>.jsonl

# Judgement holds: a verified human may release these (World ID for Agents, below)
TRIAGE_MAX_PRESSURE=0.5               # System-1 pressure above this (or urgency wording) holds the payment
AUTO_CLEAR_MAX_YEN=                   # optional: amounts above this never auto-clear

# World ID for Agents (RFC 8628 device grant): off unless both client values are set. Register at <issuer>/portal.
WORLD_AGENTS_ISSUER=https://sandbox.auth.world.org
WORLD_AGENTS_CLIENT_ID=
WORLD_AGENTS_CLIENT_SECRET=           # shown once at registration; only ever sent to the issuer
WORLD_AGENTS_AUTH_METHOD=client_secret_basic   # or client_secret_post
WORLD_AGENTS_APPROVERS=               # comma-separated pairwise subs, matched exactly
WORLD_AGENTS_ENROLL=                  # 1 only for the private enrolment run: the first approver is saved; then restart without it
WORLD_AGENTS_APPROVERS_PATH=../../data/agent/approvers.json   # relative to services/agent
WORLD_AGENTS_TRACE=                   # 1 for rehearsals: log each ID token's claim shape (never the sub) to stderr
